{:schema 1
 :library {:id yogthos/samizdat
           ;; Compatibility id for the instrumentable M2 semantic surface.
           ;; Resource-only commits may advance without changing this contract.
           :version "5bcf270fced63507e70ce10baa1b580c1b42a5c6"}
 :aspects
 [{:id :samizdat.agent.beam/control-loop
   :match {:entry samizdat.agent.beam/run-rounds
           :arity 3}
   :advice-role :samizdat/control-loop
   :expect {:matches 1}}
  {:id :samizdat.store.runs/branch-open
   :match {:entry samizdat.store.runs/open-branch!
           :arity 3}
   :advice-role :samizdat/branch-open
   :expect {:matches 1}}
  {:id :samizdat.store.runs/branch-close
   :match {:entry samizdat.store.runs/close-branch!
           :arity 5}
   :advice-role :samizdat/branch-close
   :expect {:matches 1}}
  {:id :samizdat.agent.beam/turn
   :match {:entry samizdat.agent.beam/advance-branch
           :arity 3}
   :advice-role :samizdat/turn
   :expect {:matches 1}}
  {:id :samizdat.agent.infer/model
   :match {:entry samizdat.llm.client/chat
           :arity 4}
   :advice-role :samizdat/model
   :expect {:matches 1}}
  {:id :samizdat.agent.infer/tool-selection
   :match {:entry samizdat.agent.infer/absorb
           :arity 3}
   :advice-role :samizdat/tool-selection
   :expect {:matches 1}}
  {:id :samizdat.agent.loop/tool
   :match {:entry samizdat.agent.tools/run-tool
           :arity 1}
   :advice-role :samizdat/tool
   :expect {:matches 1}}
  {:id :samizdat.agent.arbiter/steer
   :match {:entry samizdat.agent.arbiter/decide
           :arity 1}
   :advice-role :samizdat/steer
   :expect {:matches 1}}
  {:id :samizdat.llm.client/http-post
   :match {:ns samizdat.llm.client
           :call jolt.http-client/post
           :arity 2}
   :advice-role :http/client
   :expect {:matches 1}}]}
