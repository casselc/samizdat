;; The FEATURE loop: the high-level manifest. It tracks a feature through its
;; lifecycle as a state machine and delegates each stage to a ROLE:
;;
;;   plan -> implement -> review -> critique -> supervise -> route
;;                ^__________________________________revise____|
;;
;;   plan       decompose the feature into parts (team/plan)
;;   implement  a FAN-OUT of implementor workers, collaborating on the parts
;;              (team/fan-out) — the horizontal team lives here, INSIDE the
;;              feature loop, as one stage
;;   review     the REVIEWER role reads the implementors' combined work and
;;              returns PASS / REVISE (feature/review runs reviewer.edn)
;;   critique   the CRITIC role gates the result: deterministic checks + judge
;;              (feature/critique). Together with review this is GATE 1: a diff
;;              exists and it passed review.
;;   verify     GATE 2 — run the tests (:run :verify-cmd); they must pass
;;              (feature/verify). Both gates green = the task is done.
;;   supervise  watches the role loops and can adjust the outer loop — e.g. on
;;              an implement round that shipped nothing, force another round
;;              (feature/supervise)
;;   route      keep solving by default — ship only real, verified work; send it
;;              back to implement with the findings as guidance otherwise;
;;              abandon (honestly unsolved) only in the extreme, when the
;;              supervisor gives up or the :run :max-revisions backstop trips
;;              (feature/route)
;;
;; The hierarchy is explicit: this manifest is the feature; each role has its
;; own loop (implementor = worker.edn, reviewer.edn, critic = the judge) and its
;; own prompt, and owns/tunes its own manifest. Select with config
;; :run :loop "feature". Pass config :run :subtasks to skip planning.
{:description "Build a feature end to end, supervised: plan -> a fan-out of implementors -> review -> critique -> run the tests -> a supervisor that watches and steers. The default for a normal feature that one round of implementors can carry."
 :cells {:start     :loop/assemble
         :plan      :team/plan
         :fanout    :team/fan-out
         :decompose :decompose/run
         :review    :feature/review
         :critique  :feature/critique
         :verify    :feature/verify
         :supervise :feature/supervise
         :route     :feature/route
         :finish    :loop/finish}

 ;; The IMPLEMENT stage is switchable at runtime: plan dispatches to the fan-out
 ;; (the default) or the decompose-on-stuck loop, on :implement-strategy — which
 ;; the supervisor can set mid-run when the implementors keep failing a whole
 ;; task in one shot. A revise round returns to plan so the (possibly new)
 ;; strategy is re-dispatched.
 :edges {:start     :plan
         :plan      {:decompose :decompose :fanout :fanout}
         :fanout    :review
         :decompose :review
         :review    :critique
         :critique  :verify
         :verify    :supervise
         :supervise :route
         :route     {:ship   :finish
                     :revise :plan}
         :finish    :end}

 :dispatches {:plan  [[:decompose (fn [d] (= "decompose" (:implement-strategy d)))]
                      [:fanout    (fn [d] true)]]
              :route [[:ship   (fn [d] (= :ship   (:feature/decision d)))]
                      [:revise (fn [d] (= :revise (:feature/decision d)))]]}}
