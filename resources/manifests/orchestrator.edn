;; A HIGH-LEVEL loop composed of sub-loops. This is the same behavior as the
;; flat `critic` manifest, but authored hierarchically: the top level describes
;; the overall loop, and the actual work and the finalization judge are nested
;; sub-workflows (mycelium.compose wraps a whole manifest as one cell).
;;
;; :start runs the WORKER sub-loop (manifests/worker.edn) to a terminal verdict;
;; a :done branch is handed to the CRITIC, which either ships it or sends it
;; back to the worker to keep going; :abandoned/:exhausted finish directly.
;; Select with config :run :loop "orchestrator".
;;
;; This is the structural basis for multi-agent work: once a worker is a
;; composable sub-loop, a top level can run several of them — one per agent,
;; each its own loop — coordinating through the shared workspace and mailbox.
{:subworkflows {:loop/worker "worker"}

 :cells {:start  :loop/worker
         :critic :gate/critic
         :finish :loop/finish}

 :edges {:start  {:done      :critic
                  :abandoned :finish
                  :exhausted :finish}
         :critic {:ship   :finish
                  :revise :start}
         :finish :end}

 :dispatches {:start  [[:done      (fn [d] (= :done (:verdict d)))]
                       [:abandoned (fn [d] (= :abandoned (:verdict d)))]
                       [:exhausted (fn [d] (= :exhausted (:verdict d)))]]
              :critic [[:ship   (fn [d] (= :ship (:critic/decision d)))]
                       [:revise (fn [d] (= :revise (:critic/decision d)))]]}}
