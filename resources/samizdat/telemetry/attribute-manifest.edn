;; Samizdat telemetry attribute manifest — the one semantic contract every
;; emitter (Jolt wrappers, the Python pilot adapter, the historical importer)
;; and every rendering (JSON for Python, typed-column fragments for
;; jolt-otel-clickhouse, the Langfuse attribute mapping) is generated from.
;;
;; Per attribute:
;;   :key        canonical OTel attribute key, string
;;   :type       :string | :boolean | :int64 | :double
;;   :group      documentation grouping only
;;   :domain     closed value set (strings) when the attribute is an enum
;;   :authority  who owns the truth of the value — telemetry never decides it:
;;               :journal (Samizdat store), :evidence (a preserved evidence
;;               record), :runtime (measured by the emitting process),
;;               :import (labels the importer adds), :telemetry (versions)
;;   :promote?   member of the closed set of typed ClickHouse columns; only
;;               :string/:boolean/:int64 may be promoted, doubles never are
;;   :langfuse   :trace-metadata | :observation-metadata | :usage | :session
;;               | :type | :model | :none
;;   :missing    what an ABSENT key means: :unavailable (the fact exists but
;;               was not measurable — emitters also set samizdat.value.basis)
;;               or :not-applicable (absence is ordinary)
;;
;; False, zero, negative and empty-string values are real values and are
;; always emitted; only nil is "absent".
{:schema "samizdat-telemetry/1"
 :mapping-version "samizdat-langfuse-mapping/2"
 :fallback-prefix "samizdat.x."
 :observation-kinds ["agent" "generation" "tool" "evaluator" "span"]
 :session-keys ["samizdat.family.id" "samizdat.run.id"]
 :max-promoted 16
