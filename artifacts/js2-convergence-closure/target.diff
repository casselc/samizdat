diff --git a/test/samizdat/util_test.clj b/test/samizdat/util_test.clj
index fb07a5e..8cfcc85 100644
--- a/test/samizdat/util_test.clj
+++ b/test/samizdat/util_test.clj
@@ -34,4 +34,15 @@
 
   (testing "middle marker present"
     (let [result (util/truncate-middle "abcdefghijklmnopqrstuvwxyz" 10)]
+      (is (str/includes? result " … "))))
+
+  (testing "max-len smaller than marker returns a prefix of exactly max-len"
+    (is (= "ab" (util/truncate-middle "abcdef" 2)))
+    (is (= 2 (count (util/truncate-middle "abcdef" 2))))
+    (is (= "" (util/truncate-middle "abcdef" 0)))
+    (is (= 0 (count (util/truncate-middle "abcdef" 0)))))
+
+  (testing "max-len equal to marker width keeps head/marker/tail behaviour"
+    (let [result (util/truncate-middle "abcdefghijklmnopqrstuvwxyz" 3)]
+      (is (= 3 (count result)))
       (is (str/includes? result " … ")))))
