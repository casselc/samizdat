 :finding-a
 {:name "project-image cwd / JOLT_PWD"
  :where "src/samizdat/repl/image.clj start!"
  :cause "the child was given a scrubbed copy of the controller's own
          environment, which still carried the controller's JOLT_PWD; the
          Jolt launcher prefers JOLT_PWD over the process cwd, so the project
          image resolved relative paths against the CONTROLLER's root while
          :dir said otherwise"
  :fix "the spawn sets JOLT_PWD to the canonical project root, so the two
        agree and there is one answer to \"where am I\""
  :ordinary-suite-before {:tests 1860 :assertions 7978 :failures 4 :errors 0}
  :ordinary-suite-after  {:tests 1864 :assertions 8037 :failures 0 :errors 0}
  :allowlist :deleted
  :allowlist-note "not retired, not kept for compatibility — a named exception
                   is a load-bearing claim about a cause, and this one was
                   false for as long as it stood"}

 :finding-b
 {:name "per-invocation poison"
  :where "src/samizdat/security/smolvm_project_env.clj"
  :was "one slot holding one invocation"
  :defect "two overlapping timeouts: the second overwrote the first, and
           whichever cleanup finished first cleared the other's uncertainty
           along with its own — after which a new execution started on a
           provider that still had an unresolved machine and no memory of it"
  :now "a set of {invocation -> evidence}; each invocation poisons and
        resolves only its own entry; a new execution is refused while any
        entry remains; no invocation can clear another's"}

 :finding-c
 {:name "banner-only ownership"
  :where "src/samizdat/security/smolvm_project_env.clj owned-machines"
  :was "the manager's banner, else the single machine appearing since a
        baseline read immediately before the spawn"
  :defect "under concurrency the difference can name another run's machine —
           A's own machine never registers, B spawns after A's baseline, the
           difference is exactly one candidate and it is B's. The rule was
           most confident precisely when it was alone with somebody else's VM."
  :now "one source only: the manager's own startup banner. No banner means
        ownership UNKNOWN, nothing is deleted, the cleanup is not clean, and
        the invocation stays poisoned. The table travels as evidence
        (:cleanup/candidates), never as authority."}

