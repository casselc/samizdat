#!/bin/sh
# Exact JS1 M2 bounded conformance lane. Ordinary Samizdat never invokes this.
#
# Differences from the M1 lane, all deliberate:
# - Jolt is pinned to the no-replace extension (f8899905, the
#   js1-m2-verify-closure worktree): jolt.publish is the primitive
#   samizdat.security.no-replace publishes through, so the bounded lane and
#   the suite below it need that checkout, not the M1 base.
# - JOLT_CHEZ is pinned (default /usr/local/bin/scheme) for every Jolt
#   invocation: bin/jolt's threaded-Chez auto-discovery failed on this
#   machine once already, and exact evidence does not rediscover tools.
# - The bwrap adversarial step DEMANDS the real substrate. Without bwrap or
#   prlimit (or with an unresolvable pinned verifier) the VE suite greenly
#   pins refusal — valid coverage, but not adversarial evidence; this lane
#   records real spawns only.
# - test-smolvm is optional and configured-only: it requires the controller
#   image configuration (SAMIZDAT_SMOLVM_IMAGE + SAMIZDAT_SMOLVM_IMAGE_SHA256)
#   and the real machine substrate, and reports a clear result.
set -eu

JOLT_SHA=f8899905d98a0abdcc6b4ae61dfd5c8bdb9c7277
SCI_SHA=32d62a5136ad3dc148588752f5bcc4cc30b14752
SCI_VERSION=0.13.53
CHEZ=${JOLT_CHEZ:-/usr/local/bin/scheme}
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)
JOLT=${JOLT_HOME:-"$ROOT/../jolt-m2-verify-closure"}

fail() {
  printf 'js1-m2: %s\n' "$*" >&2
  exit 1
}

# The Samizdat under test: its SHA is named in every record, and a checkout
# with tracked modifications is refused — exact evidence must describe the
# bytes that actually ran, in the tested repository as in its runtime.
samizdat_sha() {
  git -C "$ROOT" rev-parse HEAD
}

check_samizdat() {
  [ -d "$ROOT/.git" ] || fail "no Samizdat checkout at $ROOT"
  sam_dirty=$(git -C "$ROOT" status --porcelain --untracked-files=no --ignore-submodules=all)
  if [ -n "$sam_dirty" ]; then
    printf 'js1-m2: tested Samizdat checkout has tracked modifications; exact evidence refused:\n%s\n' "$sam_dirty" >&2
    exit 1
  fi
}

check_jolt() {
  [ -x "$JOLT/bin/jolt" ] || fail "no Jolt checkout at $JOLT"
  actual=$(git -C "$JOLT" rev-parse HEAD)
  [ "$actual" = "$JOLT_SHA" ] || fail "Jolt SHA $actual, expected $JOLT_SHA"
  dirty=$(git -C "$JOLT" status --porcelain --untracked-files=no --ignore-submodules=all)
  if [ -n "$dirty" ]; then
    printf 'js1-m2: pinned Jolt checkout has tracked modifications; exact evidence refused:\n%s\n' "$dirty" >&2
    exit 1
  fi
  sci_actual=$(git -C "$JOLT/vendor/sci" rev-parse HEAD)
  [ "$sci_actual" = "$SCI_SHA" ] || fail "SCI SHA $sci_actual, expected $SCI_SHA"
  sci_dirty=$(git -C "$JOLT/vendor/sci" status --porcelain --untracked-files=no)
  [ -z "$sci_dirty" ] || fail "pinned SCI checkout has tracked modifications"
  version=$(tr -d '\r\n' < "$JOLT/vendor/sci/resources/SCI_VERSION")
  [ "$version" = "$SCI_VERSION" ] || fail "SCI version $version, expected $SCI_VERSION"
}

check() {
  check_samizdat
  check_jolt
  printf 'Samizdat %s\nJolt %s\nSCI %s / %s\n' \
    "$(samizdat_sha)" "$JOLT_SHA" "$SCI_SHA" "$SCI_VERSION"
}

# Every Jolt invocation below runs through this: the pinned Chez, and the
# pinned checkout's bin first on PATH so the VE controller resolves THIS
# launcher as the sandboxed verifier (resolve-verifier tries PATH, then
# cwd/bin/jolt — never a bare name in the child's PATH).
jolt_env() {
  [ -x "$CHEZ" ] || fail "no Chez at $CHEZ (set JOLT_CHEZ)"
  JOLT_CHEZ=$CHEZ
  PATH="$JOLT/bin:$PATH"
  export JOLT_CHEZ PATH
}

# Run clojure.test namespaces in the Samizdat root and exit non-zero on any
# failure or error — the js1-m1 exit contract.
run_focused() {
  label=$1
  shift
  printf '\n== js1-m2: %s ==\n' "$label"
  reqs='(quote clojure.test)'
  nses=''
  for ns in "$@"; do
    reqs="$reqs (quote $ns)"
    nses="$nses (quote $ns)"
  done
  cd "$ROOT"
  "$JOLT/bin/jolt" -A:test -e "(require $reqs)
   (let [{:keys [fail error] :as r}
         (clojure.test/run-tests$nses)]
     (println r)
     (System/exit (if (pos? (+ fail error)) 1 0)))"
}

jolt_abi() {
  printf '\n== js1-m2: Jolt ABI probe ==\n'
  if (cd "$JOLT" && sh test/chez/atomic-publish-abi-probe.sh) >"$log" 2>&1; then
    cat "$log"
  else
    cat "$log"
    fail "atomic-publish ABI probe exited non-zero"
  fi
  grep -q 'ATOMIC-PUBLISH-ABI-PROBE OK' "$log" \
    || fail "ABI probe did not report ATOMIC-PUBLISH-ABI-PROBE OK"
}

jolt_race() {
  printf '\n== js1-m2: Jolt publish race ==\n'
  if (cd "$JOLT" && "$JOLT/bin/jolt" run test/chez/atomic-publish-test.clj) >"$log" 2>&1; then
    cat "$log"
  else
    cat "$log"
    fail "atomic-publish race test exited non-zero"
  fi
  grep -q 'ATOMIC-PUBLISH-TEST OK' "$log" \
    || fail "race test did not report ATOMIC-PUBLISH-TEST OK"
}

bounded() {
  printf '\n== js1-m2: bounded M1/M2 (pinned SCI) ==\n'
  cd "$ROOT"
  SAMIZDAT_BOUNDED_TEST=1 "$JOLT/bin/jolt" \
    -Sdeps "{:deps {borkdude/sci {:local/root \"$JOLT/vendor/sci\"}}}" \
    -A:test -e '(require (quote clojure.test) (quote samizdat.evaluator-test))
                 (let [{:keys [fail error] :as r}
                       (clojure.test/run-tests (quote samizdat.evaluator-test))]
                   (println r)
                   (System/exit (if (pos? (+ fail error)) 1 0)))'
}

ordinary() {
  printf '\n== js1-m2: ordinary suite ==\n'
  cd "$ROOT"
  # The ulimit raise mirrors the deps.edn :tasks test entry: the suite holds
  # many open fds and the default soft limit starves it.
  if (ulimit -n 1024 2>/dev/null; "$JOLT/bin/jolt" -M:test); then
    :
  else
    fail "ordinary suite (jolt -M:test) failed"
  fi
}

bwrap_adversarial() {
  printf '\n== js1-m2: explicit bwrap adversarial ==\n'
  # Demand the real substrate before any test runs: without it the suite
  # greenly pins refusal, and this step would record nothing adversarial.
  command -v bwrap >/dev/null 2>&1 || fail "bwrap absent: adversarial evidence requires real spawns"
  command -v prlimit >/dev/null 2>&1 || fail "prlimit absent: adversarial evidence requires real spawns"
  cd "$ROOT"
  "$JOLT/bin/jolt" -A:test -e '(require (quote samizdat.security.verification-env))
     (let [ok (and (samizdat.security.verification-env/available?)
                   (samizdat.security.verification-env/resolve-verifier))]
       (println :substrate (if ok :real-spawns :refusing))
       (System/exit (if ok 0 1)))'
  run_focused 'bwrap adversarial (real spawns)' samizdat.verification-env-test
}

smolvm_substrate() {
  "$JOLT/bin/jolt" -A:test -e '(require (quote samizdat.security.smolvm-verification-env))
     (let [ok (samizdat.security.smolvm-verification-env/available?)]
       (println :smolvm-substrate (if ok :real-machines :refusing)
                (pr-str (samizdat.security.smolvm-verification-env/unavailable-reason)))
       (System/exit (if ok 0 1)))'
}

test_lane() {
  check
  jolt_env
  log=$(mktemp "${TMPDIR:-/tmp}/js1-m2.XXXXXX")
  trap 'rm -f "$log"' EXIT HUP INT TERM
  printf 'testing Samizdat %s\n' "$(samizdat_sha)"
  jolt_abi
  jolt_race
  bounded
  run_focused 'VE/SPI/process' \
    samizdat.verification-env-test \
    samizdat.execution-env-spi-test \
    samizdat.proc-test
  ordinary
  bwrap_adversarial
  printf '\njs1-m2: all gates green — Samizdat %s / Jolt %s / SCI %s\n' \
    "$(samizdat_sha)" "$JOLT_SHA" "$SCI_SHA"
}

test_smolvm() {
  check
  jolt_env
  [ -n "${SAMIZDAT_SMOLVM_IMAGE:-}" ] \
    || fail "test-smolvm requires SAMIZDAT_SMOLVM_IMAGE (the configured guest archive)"
  [ -n "${SAMIZDAT_SMOLVM_IMAGE_SHA256:-}" ] \
    || fail "test-smolvm requires SAMIZDAT_SMOLVM_IMAGE_SHA256 (that archive's pinned digest)"
  printf '\n== js1-m2: configured SmolVM ==\n'
  cd "$ROOT"
  # A configured image on an absent substrate yields a refusal-path green —
  # not a clear configured result. Demand the machine, then run the suite.
  smolvm_substrate
  run_focused 'configured SmolVM (real machines)' samizdat.smolvm-verification-env-test
  printf '\njs1-m2: SmolVM gate green (configured image, real machines)\n'
}

case ${1:-} in
  check)
    check
    ;;
  sha)
    # Name the tested Samizdat SHA even when the checkout is too dirty to run
    # the exact lane — a record of which commit the working tree sits on.
    printf 'Samizdat %s\n' "$(samizdat_sha)"
    ;;
  test)
    test_lane
    ;;
  test-smolvm)
    test_smolvm
    ;;
  *)
    printf 'usage: bin/js1-m2 check|sha|test|test-smolvm\n' >&2
    exit 2
    ;;
esac
