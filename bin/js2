#!/bin/sh
# Exact JS2 gates, on CURRENT upstream. Ordinary Samizdat never invokes this lane.
#
# A NEW gate, not a widened old one. bin/js1-m3 pins the M4 runtime and must
# keep pinning it: rewriting it to accept the JS2 Jolt would make every
# historical M1-M4 record claim to have run against a runtime that did not
# exist when they ran. The two lanes coexist; neither describes the other's
# bytes.
#
# The check hardening is the js1 lanes' contract carried over verbatim: a
# pinned checkout with tracked modifications — Samizdat, Jolt, or the vendored
# SCI — is refused with its dirty listing, because exact evidence must describe
# the bytes that actually ran. JS2 adds one more pin for the same reason: the
# guest image the project execution environment runs a model's argv inside is
# named by DIGEST, so the isolation evidence describes the image that provided
# it.
set -eu

JOLT_SHA=c8d9181e23cc37aa91a38fdcbd01c93917b1be50
SCI_SHA=32d62a5136ad3dc148588752f5bcc4cc30b14752
SCI_VERSION=0.13.53
UPSTREAM_BASE=34a21ab1fb1063ad3eac7905f98a37ad5635427f
CHEZ=${JOLT_CHEZ:-/usr/local/bin/scheme}
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)
JOLT=${JOLT_HOME:-"$ROOT/../jolt-js2"}

# THE ORDINARY GATE IS ZERO FAILURES. There is no allowlist.
#
# There WAS one, for four upstream tests this lane called "upstream's own
# Linux-sandbox failures". That reading was wrong, and the allowlist is what
# kept it wrong: all four assert the run-root cwd contract, which holds under
# EVERY backend including :none, and they failed because `repl.image/start!`
# handed the child a scrubbed copy of the controller's own environment — with
# the controller's `JOLT_PWD` still in it. The Jolt launcher prefers
# `JOLT_PWD` over the process cwd, so the project image resolved relative
# paths against the CONTROLLER's root while the gate explained the failure as
# a missing sandbox backend.
#
# A named exception is a load-bearing claim about a cause, and this one was
# load-bearing and false for as long as it stood. Deleted rather than kept
# "for compatibility": a dead allowlist is an explanation waiting to be
# believed again.

fail() {
  printf 'js2: %s\n' "$*" >&2
  exit 1
}

sha() { git -C "$ROOT" rev-parse HEAD; }

check_samizdat() {
  [ -d "$ROOT/.git" ] || fail "no Samizdat checkout at $ROOT"
  sam_dirty=$(git -C "$ROOT" status --porcelain --untracked-files=no --ignore-submodules=all)
  if [ -n "$sam_dirty" ]; then
    printf 'js2: tested Samizdat checkout has tracked modifications; exact evidence refused:\n%s\n' "$sam_dirty" >&2
    exit 1
  fi
}

check_jolt() {
  [ -x "$JOLT/bin/jolt" ] || fail "no Jolt checkout at $JOLT"
  [ -x "$CHEZ" ] || fail "no Chez at $CHEZ (set JOLT_CHEZ)"
  actual=$(git -C "$JOLT" rev-parse HEAD)
  [ "$actual" = "$JOLT_SHA" ] || fail "Jolt SHA $actual, expected $JOLT_SHA"
  dirty=$(git -C "$JOLT" status --porcelain --untracked-files=no --ignore-submodules=all)
  if [ -n "$dirty" ]; then
    printf 'js2: pinned Jolt checkout has tracked modifications; exact evidence refused:\n%s\n' "$dirty" >&2
    exit 1
  fi
  sci_actual=$(git -C "$JOLT/vendor/sci" rev-parse HEAD)
  [ "$sci_actual" = "$SCI_SHA" ] || fail "SCI SHA $sci_actual, expected $SCI_SHA"
  sci_dirty=$(git -C "$JOLT/vendor/sci" status --porcelain --untracked-files=no)
  if [ -n "$sci_dirty" ]; then
    printf 'js2: pinned SCI checkout has tracked modifications; exact evidence refused:\n%s\n' "$sci_dirty" >&2
    exit 1
  fi
  version=$(tr -d '\r\n' < "$JOLT/vendor/sci/resources/SCI_VERSION")
  [ "$version" = "$SCI_VERSION" ] || fail "SCI version $version, expected $SCI_VERSION"
}

# The guest image is the JS2 pin the js1 lanes had no equivalent of: it is
# what a model's argv actually runs inside, so the isolation evidence is only
# as exact as the bytes that provided the isolation.
check_image() {
  [ -n "${SAMIZDAT_SMOLVM_IMAGE:-}" ] || \
    fail "SAMIZDAT_SMOLVM_IMAGE is unset; the project execution environment has no guest"
  [ -n "${SAMIZDAT_SMOLVM_IMAGE_SHA256:-}" ] || \
    fail "SAMIZDAT_SMOLVM_IMAGE_SHA256 is unset; an unpinned guest image is refused"
  [ -f "$SAMIZDAT_SMOLVM_IMAGE" ] || \
    fail "no guest image at $SAMIZDAT_SMOLVM_IMAGE"
  image_actual=$(sha256sum "$SAMIZDAT_SMOLVM_IMAGE" | cut -d' ' -f1)
  expected=$(printf '%s' "$SAMIZDAT_SMOLVM_IMAGE_SHA256" | sed 's/^sha256://')
  [ "$image_actual" = "$expected" ] || \
    fail "guest image digest $image_actual, expected $expected"
}

check() {
  check_samizdat
  check_jolt
  check_image
  printf 'Samizdat %s\nUpstream base %s\nJolt %s\nSCI %s / %s\nGuest image sha256:%s\n' \
    "$(sha)" "$UPSTREAM_BASE" "$JOLT_SHA" "$SCI_SHA" "$SCI_VERSION" "$image_actual"
}

# Every Jolt invocation below runs through this: the pinned Chez, and the
# pinned checkout's bin first on PATH so any nested verifier resolution lands
# on THIS launcher.
jolt_env() {
  JOLT_CHEZ=$CHEZ
  PATH="$JOLT/bin:$PATH"
  export JOLT_CHEZ PATH
}

run_ns() {
  label=$1
  shift
  printf '\n== js2: %s ==\n' "$label"
  reqs='(quote clojure.test)'
  nses=''
  for ns in "$@"; do
    reqs="$reqs (quote $ns)"
    nses="$nses (quote $ns)"
  done
  (cd "$ROOT" && "$JOLT/bin/jolt" -A:test -e "(require $reqs)
    (let [{:keys [fail error] :as r} (clojure.test/run-tests$nses)]
      (println r) (System/exit (if (pos? (+ fail error)) 1 0)))")
}

# Authority, provenance and lease closure — the M1-M4 contract this milestone
# must not have moved, plus the derived-surface conformance, which now also
# covers the CURRENT upstream seams (the new tools, the role catalogue, and
# the REPL-session contract that would otherwise withhold a bounded eval).
focused() {
  run_ns 'authority, provenance, lease and surface closure' \
    samizdat.m3-controller-test samizdat.control-test \
    samizdat.agent-turn-lease-test samizdat.surface-test
}

# The pinned bounded evaluator: M1/M2/M4's own lane, and JS2's semantic
# execution beside it, under the exact runtime and the vendored SCI.
bounded() {
  printf '\n== js2: pinned bounded evaluator ==\n'
  (cd "$ROOT" && SAMIZDAT_BOUNDED_TEST=1 "$JOLT/bin/jolt" \
    -Sdeps "{:deps {borkdude/sci {:local/root \"$JOLT/vendor/sci\"}}}" \
    -A:test -e '(require (quote clojure.test) (quote samizdat.evaluator-test)
                         (quote samizdat.js2-project-run-test))
      (let [{:keys [fail error] :as r}
            (clojure.test/run-tests (quote samizdat.evaluator-test)
                                    (quote samizdat.js2-project-run-test))]
        (println r) (System/exit (if (pos? (+ fail error)) 1 0)))')
}

# The execution environments, for real. Both of them: the model-authorized one
# JS2 adds, and the controller-owned verify one it must not have disturbed.
# These boot actual machines; check_image has already pinned which bytes.
environments() {
  run_ns 'project execution and verification environments (machine-backed)' \
    samizdat.js2-project-env-test samizdat.smolvm-verification-env-test \
    samizdat.execution-env-spi-test samizdat.verification-env-test
}

# CROSS-RUN OWNERSHIP, named as its own lane.
#
# The defect this convergence fixes does not appear in a single-agent canary
# by construction: one execution at a time cannot interfere with another. The
# lane exists so the evidence has somewhere to point that is about
# concurrency and nothing else.
#
# The closure pass adds three, and they are the ones that had no lane before:
# two REAL simultaneous timeouts (the single poison slot could not represent
# them, and whichever cleaned up first cleared the other's uncertainty with
# its own); the poison as a SET, each invocation resolving only its own entry;
# and a timeout with no banner, which must act on NOTHING even though a set
# difference would have named exactly one machine — another run's.
concurrency() {
  printf '\n== js2: concurrent execution ownership (machine-backed) ==\n'
  (cd "$ROOT" && "$JOLT/bin/jolt" -A:test -e '
    (require (quote clojure.test) (quote samizdat.js2-project-env-test))
    (let [{:keys [fail error] :as r}
          (binding [clojure.test/*report-counters*
                    (ref clojure.test/*initial-report-counters*)]
            (clojure.test/test-vars
             (mapv resolve
                   (quote [samizdat.js2-project-env-test/concurrent-executions-clean-up-only-their-own-machines
                           samizdat.js2-project-env-test/two-successful-concurrent-executions-do-not-interfere
                           samizdat.js2-project-env-test/two-simultaneous-timeouts-each-clean-up-only-themselves
                           samizdat.js2-project-env-test/the-poison-set-holds-every-unresolved-invocation-separately
                           samizdat.js2-project-env-test/a-timeout-without-a-banner-refuses-to-touch-another-runs-machine
                           samizdat.js2-project-env-test/ownership-comes-from-the-manager-or-it-does-not-come-at-all])))
            (deref clojure.test/*report-counters*))]
      (println r)
      (System/exit (if (pos? (+ (or fail 0) (or error 0))) 1 0)))')
}

full() {
  printf '\n== js2: ordinary suite (against the upstream baseline) ==\n'
  # The suite holds many open fds and a low soft limit starves it (provenance
  # A-3). RAISE THE SOFT LIMIT ONLY: `ulimit -n N` sets the hard limit too, and
  # lowering a hard limit is irreversible for the whole process tree — which on
  # a host whose default is already generous turns a line meant to raise a
  # limit into one that lowers it, and the project execution environment then
  # refuses because a host limit would otherwise reach inside its guest.
  out=$(cd "$ROOT"
        if [ "$(ulimit -Sn)" -lt 65536 ] 2>/dev/null; then
          ulimit -Sn 65536 2>/dev/null || ulimit -Sn "$(ulimit -Hn)" 2>/dev/null || true
        fi
        "$JOLT/bin/jolt" -M:test 2>&1) || true
  printf '%s\n' "$out" | tail -3
  # Every failing test name, deduplicated. ANY of them fails the lane.
  failing=$(printf '%s\n' "$out" \
            | sed -n 's/^\(FAIL\|ERROR\) in (\([^)]*\)).*/\2/p' | sort -u \
            | grep -v '^$' || true)
  if [ -n "$failing" ]; then
    printf 'js2: ordinary suite is not green:\n%s\n' "$failing" >&2
    # The detail too, not just the names — a gate that says only WHICH test
    # broke makes the next person run the whole suite again to find out how.
    printf '%s\n' "$out" | grep -A8 -E '^(FAIL|ERROR) in' >&2 || true
    exit 1
  fi
  printf '%s\n' "$out" | grep -q ':type :summary' || fail 'ordinary suite produced no summary'
}

case ${1:-} in
  check) check ;;
  sha) printf 'Samizdat %s\n' "$(sha)" ;;
  focused) check; jolt_env; focused ;;
  bounded) check; jolt_env; bounded ;;
  env) check; jolt_env; environments ;;
  concurrency) check; jolt_env; concurrency ;;
  full) check; jolt_env; full ;;
  test) check; jolt_env; focused; bounded; environments; concurrency; full ;;
  *) printf 'usage: bin/js2 check|sha|focused|bounded|env|concurrency|full|test\n' >&2; exit 2 ;;
esac
